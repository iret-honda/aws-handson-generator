{
  "mcpServers": {
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "aws-documentation": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@1.2.2"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "aws-iac": {
      "command": "uvx",
      "args": ["awslabs.aws-iac-mcp-server@1.0.26"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "${HANDSON_AWS_PROFILE:-default}",
        "AWS_REGION": "${HANDSON_AWS_REGION:-ap-northeast-1}"
      }
    },
    "aws-terraform": {
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@1.0.18"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "sandbox-runner": {
      "command": "uv",
      "args": ["run", "--quiet", "--project", "mcp/sandbox-runner", "sandbox-runner"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-pricing": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@1.1.1"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "${HANDSON_AWS_PROFILE:-default}",
        "AWS_REGION": "us-east-1"
      }
    }
  }
}
