# テレメトリの生データ(ジョブごとの集計結果は jobs/<job-id>/token-report.md に残る)
# jobs/<job-id>/telemetry.json は report.py が毎回作る抽出結果で、メールアドレスや組織IDを含むためコミットしない
telemetry/data/
jobs/*/telemetry.json
# sandbox-runner の作業領域(生の出力、シェル変数、セッション。アカウントIDや受信ハンドルを含む)
jobs/*/sandbox/

# IaC の生成物と state
node_modules/
cdk.out/
cdk.context.json
.terraform/
*.tfstate
*.tfstate.*

.DS_Store

# Python(sandbox-runner)
.venv/
__pycache__/
.pytest_cache/

# 個人用の Claude Code 設定(テレメトリの env など)
.claude/settings.local.json
outputs/
# 設計書の PDF は作成者の氏名を含むため公開リポジトリに置かない(各自のローカルに保持)
docs/*.pdf
